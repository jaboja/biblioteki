[Unit]
Description=Biblioteki Backend Service
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=biblioteki
Group=biblioteki
WorkingDirectory=/opt/biblioteki
EnvironmentFile=/etc/biblioteki/application.env
ExecStart=/usr/bin/java -jar /opt/biblioteki/biblioteki-0.0.1-SNAPSHOT.jar
SuccessExitStatus=143
Restart=always
RestartSec=30
StandardOutput=append:/var/log/biblioteki/stdout.log
StandardError=append:/var/log/biblioteki/stderr.log
SyslogIdentifier=biblioteki

# Ograniczenia zasobów (opcjonalnie)
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
